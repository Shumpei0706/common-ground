{
  "name": "common-ground",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/cloudflare-assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "WORKSHOP",
        "class_name": "Workshop"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Workshop"
      ]
    }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://your-worker.example.com",
    "OPERATOR_NAME": "Configure your operator name",
    "OPERATOR_CONTACT": "operator@example.com"
  },
  "observability": {
    "enabled": false
  }
}
